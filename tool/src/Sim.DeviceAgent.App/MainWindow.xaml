<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sim.DeviceAgent.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="HeaderText" FontSize="22" FontWeight="SemiBold" Text="Device Agent" />
            <TextBlock x:Name="StateText" Opacity="0.8" Text="正在启动…" />
        </StackPanel>

        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="1"
            Title="配置或运行时错误"
            IsClosable="False"
            IsOpen="False"
            Severity="Error" />

        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="设备通道" />
                <ListView x:Name="ChannelList" Height="340" SelectionMode="None" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="出口" />
                <ListView x:Name="SinkList" Height="340" SelectionMode="None" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="2">
            <TextBlock x:Name="ConfigText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock x:Name="ReloadText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock FontSize="12" Opacity="0.5" Text="关闭窗口将最小化到托盘；退出请使用托盘菜单。" />
        </StackPanel>
    </Grid>
</Window>
