<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 浮层控件族：Tooltip 隐式样式。
       Modal / Drawer / Popconfirm / Message 为 C# 构建的窗口，见 Controls/Overlay。
       视觉约束：禁止投影，浮层只用 2px 描边表达层级。 -->

  <Style TargetType="{x:Type ToolTip}">
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToolTip}">
          <Border Background="{DynamicResource PaperBrush}"
                  BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="2"
                  CornerRadius="8"
                  Padding="8,6"
                  SnapsToDevicePixels="True">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ContextMenu}">
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <Border Background="{DynamicResource PaperBrush}"
                  BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="2"
                  CornerRadius="10"
                  Padding="4"
                  SnapsToDevicePixels="True">
            <ItemsPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
