<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:display="clr-namespace:Sim.Admin.Wpf.Client.Controls.Display">

  <!-- 展示控件族：Tag / Badge / Avatar / Divider / Progress / Spin / Skeleton / Empty / Result /
       Alert / Descriptions。
       视觉约束：不使用任何投影，层级只由 2px 描边、圆角与语义色表达；颜色全部使用 DynamicResource。 -->

  <!-- ============ CustomTag ============ -->
  <Style TargetType="{x:Type display:CustomTag}">
    <Setter Property="Height" Value="24"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="8,1"/>
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type display:CustomTag}">
          <Border x:Name="Root"
                  Background="{TemplateBinding ToneSoftBrush}"
                  BorderBrush="{TemplateBinding ToneBrush}"
                  BorderThickness="2"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Size" Value="Small">
              <Setter Property="Height" Value="20"/>
              <Setter Property="FontSize" Value="11"/>
              <Setter Property="Padding" Value="6,0"/>
            </Trigger>
            <Trigger Property="Size" Value="Large">
              <Setter Property="Height" Value="28"/>
              <Setter Property="FontSize" Value="13"/>
              <Setter Property="Padding" Value="10,2"/>
            </Trigger>
            <Trigger Property="Round" Value="True">
              <Setter TargetName="Root" Property="CornerRadius" Value="10"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Round" Value="True"/>
                <Condition Property="Size" Value="Large"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Root" Property="CornerRadius" Value="14"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ CustomBadge ============ -->
  <Style TargetType="{x:Type display:CustomBadge}">
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type display:CustomBadge}">
          <Grid>
            <ContentPresenter/>
            <Border x:Name="Badge"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    MinWidth="18"
                    Height="18"
                    CornerRadius="9"
                    Padding="5,0"
                    Background="{TemplateBinding ToneBrush}"
                    RenderTransformOrigin="0,0">
              <Border.RenderTransform>
                <TranslateTransform X="8" Y="-8"/>
              </Border.RenderTransform>
              <TextBlock x:Name="BadgeText"
                         Text="{TemplateBinding BadgeText}"
                         Foreground="{DynamicResource PaperBrush}"
                         FontSize="11"
                         FontWeight="Bold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasBadge" Value="False">
              <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Dot" Value="True">
              <Setter TargetName="Badge" Property="MinWidth" Value="8"/>
              <Setter TargetName="Badge" Property="Width" Value="8"/>
              <Setter TargetName="Badge" Property="Height" Value="8"/>
              <Setter TargetName="Badge" Property="CornerRadius" Value="4"/>
              <Setter TargetName="Badge" Property="Padding" Value="0"/>
              <Setter TargetName="BadgeText" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ CustomAvatar ============ -->
  <Style TargetType="{x:Type display:CustomAvatar}">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type display:CustomAvatar}">
          <Border x:Name="Root"
                  Background="{TemplateBinding ToneSoftBrush}"
                  BorderBrush="{TemplateBinding ToneBrush}"
                  BorderThickness="2"
                  CornerRadius="18"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Round" Value="False">
              <Setter TargetName="Root" Property="CornerRadius" Value="10"/>
            </Trigger>
            <Trigger Property="Size" Value="Small">
              <Setter Property="Width" Value="28"/>
              <Setter Property="Height" Value="28"/>
              <Setter Property="FontSize" Value="12"/>
              <Setter TargetName="Root" Property="CornerRadius" Value="14"/>
            </Trigger>
            <Trigger Property="Size" Value="Large">
              <Setter Property="Width" Value="44"/>
              <Setter Property="Height" Value="44"/>
              <Setter Property="FontSize" Value="16"/>
              <Setter TargetName="Root" Property="CornerRadius" Value="22"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Round" Value="False"/>
                <Condition Property="Size" Value="Small"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Root" Property="CornerRadius" Value="8"/>
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Round" Value="False"/>
                <Condition Property="Size" Value="Large"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Root" Property="CornerRadius" Value="12"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ CustomDivider ============ -->
  <Style TargetType="{x:Type display:CustomDivider}">
    <Setter Property="Margin" Value="0,4"/>
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type display:CustomDivider}">
          <Border Padding="0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Rectangle x:Name="LineStart"
                         Height="2"
                         Fill="{DynamicResource EdgeBrush}"
                         VerticalAlignment="Center"/>
              <TextBlock x:Name="TitleText"
                         Grid.Column="1"
                         Text="{TemplateBinding Title}"
                         Margin="12,0"
                         FontSize="12"
                         FontWeight="Bold"
                         Foreground="{DynamicResource MutedBrush}"
                         VerticalAlignment="Center"/>
              <Rectangle x:Name="LineEnd"
                         Grid.Column="2"
                         Height="2"
                         Fill="{DynamicResource EdgeBrush}"
                         VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Title" Value="">
              <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Dashed" Value="True">
              <Setter TargetName="LineStart" Property="Fill" Value="Transparent"/>
              <Setter TargetName="LineStart" Property="Stroke" Value="{DynamicResource EdgeBrush}"/>
              <Setter TargetName="LineStart" Property="StrokeThickness" Value="2"/>
              <Setter TargetName="LineStart" Property="StrokeDashArray" Value="3 2"/>
              <Setter TargetName="LineEnd" Property="Fill" Value="Transparent"/>
              <Setter TargetName="LineEnd" Property="Stroke" Value="{DynamicResource EdgeBrush}"/>
              <Setter TargetName="LineEnd" Property="StrokeThickness" Value="2"/>
              <Setter TargetName="LineEnd" Property="StrokeDashArray" Value="3 2"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Vertical" Value="True">
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type display:CustomDivider}">
              <Border Width="2"
                      Background="{DynamicResource EdgeBrush}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Stretch"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============ CustomProgress ============ -->
  <Style TargetType="{x:Type display:CustomProgress}">
    <Setter Property="Height" Value="8"/>
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type display:CustomProgress}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="PART_Track"
                    Height="8"
                    Background="{DynamicResource SoftBrush}"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
              <Border x:Name="PART_Indicator"
                      HorizontalAlignment="Left"
                      Background="{TemplateBinding ToneBrush}"
                      CornerRadius="4"
                      SnapsToDevicePixels="True"/>
            </Border>
            <TextBlock x:Name="IndicatorText"
                       Grid.Column="1"
                       Text="{TemplateBinding IndicatorText}"
                       Margin="8,0,0,0"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ShowIndicator" Value="False">
              <Setter TargetName="IndicatorText" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ CustomSpin ============ -->
  <Style TargetType="{x:Type display:CustomSpin}">
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="MinHeight" Value="60"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type display:CustomSpin}">
          <Grid>
            <ContentPresenter/>
            <Border x:Name="Overlay"
                    Background="{DynamicResource PaperBrush}"
                    Opacity="0.72"/>
            <StackPanel x:Name="Indicator"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <Ellipse x:Name="Ring"
                       Width="24"
                       Height="24"
                       Stroke="{DynamicResource PrimaryBrush}"
                       StrokeThickness="3"
                       StrokeDashArray="2 1.2"
                       RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                  <RotateTransform x:Name="RingRotate"/>
                </Ellipse.RenderTransform>
              </Ellipse>
              <TextBlock x:Name="DescriptionText"
                         Text="{TemplateBinding Description}"
                         Margin="0,8,0,0"
                         FontSize="12"
                         HorizontalAlignment="Center"
                         Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Spinning" Value="False">
              <Setter TargetName="Overlay" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Indicator" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Description" Value="">
              <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Spinning" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="SpinStory">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RingRotate"
                                     Storyboard.TargetProperty="Angle"
                                     From="0"
                                     To="360"
                                     Duration="0:0:0.9"
                                     RepeatBehavior="Forever"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="SpinStory"/>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Size" Value="Small">
              <Setter TargetName="Ring" Property="Width" Value="18"/>
              <Setter TargetName="Ring" Property="Height" Value="18"/>
              <Setter TargetName="Ring" Property="StrokeThickness" Value="2"/>
            </Trigger>
            <Trigger Property="Size" Value="Large">
              <Setter TargetName="Ring" Property="Width" Value="34"/>
              <Setter TargetName="Ring" Property="Height" Value="34"/>
              <Setter TargetName="Ring" Property="StrokeThickness" Value="4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ CustomSkeleton ============ -->
  <Style TargetType="{x:Type display:CustomSkeleton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type display:CustomSkeleton}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Avatar"
                    Width="36"
                    Height="36"
                    Margin="0,0,12,0"
                    CornerRadius="10"
                    VerticalAlignment="Top"
                    Background="{DynamicResource SoftBrush}"/>
            <StackPanel x:Name="PART_Lines"
                        Grid.Column="1"
                        VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ShowAvatar" Value="False">
              <Setter TargetName="Avatar" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Animated" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="PulseStory">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PART_Lines"
                                     Storyboard.TargetProperty="Opacity"
                                     From="1"
                                     To="0.45"
                                     Duration="0:0:0.9"
                                     AutoReverse="True"
                                     RepeatBehavior="Forever"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="PulseStory"/>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ CustomEmpty ============ -->
  <Style TargetType="{x:Type display:CustomEmpty}">
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Padding" Value="24"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type display:CustomEmpty}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
            <TextBlock Text="◌"
                       FontSize="40"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock Text="{TemplateBinding Description}"
                       Margin="0,8,0,0"
                       FontSize="13"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>
            <ContentPresenter Margin="0,12,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ CustomResult ============ -->
  <Style TargetType="{x:Type display:CustomResult}">
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Padding" Value="24"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type display:CustomResult}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
            <Border Width="64"
                    Height="64"
                    CornerRadius="32"
                    BorderThickness="2"
                    BorderBrush="{TemplateBinding ToneBrush}"
                    Background="{TemplateBinding ToneSoftBrush}"
                    HorizontalAlignment="Center">
              <TextBlock Text="{TemplateBinding ToneSymbol}"
                         FontSize="28"
                         FontWeight="Bold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{TemplateBinding ToneBrush}"/>
            </Border>
            <TextBlock Text="{TemplateBinding Title}"
                       Margin="0,16,0,0"
                       FontSize="18"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource InkBrush}"/>
            <TextBlock x:Name="DescriptionText"
                       Text="{TemplateBinding Description}"
                       Margin="0,8,0,0"
                       MaxWidth="420"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>
            <ContentPresenter Margin="0,18,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Description" Value="">
              <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Title" Value="">
              <Setter Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ CustomAlert ============ -->
  <Style x:Key="CustomAlertCloseButton" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{Binding ToneBrush, RelativeSource={RelativeSource AncestorType={x:Type display:CustomAlert}}}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Background="{TemplateBinding Background}" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type display:CustomAlert}">
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type display:CustomAlert}">
          <Border x:Name="PART_Root"
                  Background="{TemplateBinding ToneSoftBrush}"
                  BorderBrush="{TemplateBinding ToneBrush}"
                  BorderThickness="2"
                  CornerRadius="12"
                  Padding="14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="Icon"
                         Text="{TemplateBinding ToneSymbol}"
                         Margin="0,0,10,0"
                         FontSize="15"
                         FontWeight="Bold"
                         VerticalAlignment="Top"
                         Foreground="{TemplateBinding ToneBrush}"/>
              <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText"
                           Text="{TemplateBinding Title}"
                           FontWeight="Bold"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{TemplateBinding ToneBrush}"/>
                <ContentPresenter x:Name="Body" Margin="0,4,0,0"/>
              </StackPanel>
              <Button x:Name="PART_Close"
                      Grid.Column="2"
                      Content="×"
                      Style="{StaticResource CustomAlertCloseButton}"
                      VerticalAlignment="Top"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Title" Value="">
              <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="ShowIcon" Value="False">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Closable" Value="False">
              <Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ CustomDescriptions ============ -->
  <Style TargetType="{x:Type display:CustomDescriptions}">
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type display:CustomDescriptions}">
          <Border x:Name="Root"
                  Background="{DynamicResource PaperBrush}"
                  BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="2"
                  CornerRadius="12"
                  ClipToBounds="True">
            <ItemsPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Bordered" Value="False">
              <Setter TargetName="Root" Property="BorderThickness" Value="0"/>
              <Setter TargetName="Root" Property="Background" Value="Transparent"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ CustomDescriptionItem ============ -->
  <Style TargetType="{x:Type display:CustomDescriptionItem}">
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type display:CustomDescriptionItem}">
          <Border x:Name="Row"
                  BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="0,0,0,2"
                  SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="LabelCell"
                      Padding="12,8"
                      Background="{DynamicResource SoftBrush}">
                <TextBlock Text="{TemplateBinding Label}"
                           MinWidth="{TemplateBinding LabelWidth}"
                           FontSize="12"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}"/>
              </Border>
              <Border Grid.Column="1" Padding="12,8">
                <ContentPresenter VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsLast" Value="True">
              <Setter TargetName="Row" Property="BorderThickness" Value="0"/>
              <Setter TargetName="LabelCell" Property="CornerRadius" Value="0,0,0,10"/>
            </Trigger>
            <Trigger Property="IsFirst" Value="True">
              <Setter TargetName="LabelCell" Property="CornerRadius" Value="10,0,0,0"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsFirst" Value="True"/>
                <Condition Property="IsLast" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="LabelCell" Property="CornerRadius" Value="10,0,0,10"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
