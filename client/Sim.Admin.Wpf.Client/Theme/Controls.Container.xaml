<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:container="clr-namespace:Sim.Admin.Wpf.Client.Controls.Container">

  <!-- 容器控件族：Tabs / Collapse / Pagination / Steps / Timeline。
       视觉约束：不使用任何投影；颜色全部 DynamicResource；不定义全局隐式 TabItem 样式。 -->

  <!-- ============ CustomMenu ============ -->

  <!-- 顶层叶节点与子项共用一组 RadioButton（手风琴内单选）；分组标题用 ToggleButton 展开/收起。 -->
  <Style x:Key="CustomMenuRowStyle" TargetType="{x:Type RadioButton}">
    <Setter Property="Height" Value="36"/>
    <Setter Property="Margin" Value="0,2"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Border x:Name="Root"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="2"
                  CornerRadius="11"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource SoftBrush}"/>
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
              <Setter Property="FontWeight" Value="Bold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CustomMenuChildRowStyle" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource CustomMenuRowStyle}">
    <Setter Property="Height" Value="32"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="Padding" Value="34,0,12,0"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <Style x:Key="CustomMenuParentRowStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Height" Value="36"/>
    <Setter Property="Margin" Value="0,2"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border x:Name="Root"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="2"
                  CornerRadius="11"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="CustomMenuChildNodeTemplate" DataType="{x:Type container:CustomMenuNode}">
    <RadioButton GroupName="SimMainMenu"
                 Style="{StaticResource CustomMenuChildRowStyle}"
                 IsChecked="{Binding IsSelected, Mode=TwoWay}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                   Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Label}" Margin="10,0,0,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </RadioButton>
  </DataTemplate>

  <DataTemplate x:Key="CustomMenuNodeTemplate" DataType="{x:Type container:CustomMenuNode}">
    <StackPanel>
      <RadioButton x:Name="Leaf"
                   GroupName="SimMainMenu"
                   Style="{StaticResource CustomMenuRowStyle}"
                   IsChecked="{Binding IsSelected, Mode=TwoWay}"
                   Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                     Width="22" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Label}" Margin="10,0,0,0" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </RadioButton>
      <ToggleButton x:Name="Parent"
                    Style="{StaticResource CustomMenuParentRowStyle}"
                    IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                    Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                     Width="22" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="10,0,0,0"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <Path Grid.Column="2"
                Width="16"
                Height="16"
                Data="M 5,3 L 10,8 L 5,13"
                Stroke="{DynamicResource MutedBrush}"
                StrokeThickness="2"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                Stretch="None"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
              <RotateTransform x:Name="ChevronRotate" Angle="0"/>
            </Path.RenderTransform>
          </Path>
        </Grid>
      </ToggleButton>
      <container:CustomMenuChildren x:Name="Children"
                                    ItemsSource="{Binding Children}"
                                    ItemTemplate="{StaticResource CustomMenuChildNodeTemplate}"
                                    IsExpanded="{Binding IsExpanded, Mode=OneWay}"/>
    </StackPanel>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsExpanded}" Value="True">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                               Storyboard.TargetProperty="Angle"
                               To="90"
                               Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                  <CubicEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                               Storyboard.TargetProperty="Angle"
                               To="0"
                               Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                  <CubicEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.ExitActions>
      </DataTrigger>
      <DataTrigger Binding="{Binding HasChildren}" Value="True">
        <Setter TargetName="Parent" Property="Visibility" Value="Visible"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding HasChildren}" Value="False">
        <Setter TargetName="Leaf" Property="Visibility" Value="Visible"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <Style TargetType="{x:Type container:CustomMenu}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="ItemTemplate" Value="{StaticResource CustomMenuNodeTemplate}"/>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ CustomTabs ============ -->

  <Style x:Key="CustomTabItemSmallStyle" TargetType="{x:Type TabItem}">
    <Setter Property="Padding" Value="10,5"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabItem}">
          <Border x:Name="Root"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="0,0,0,2"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CustomTabItemStyle" TargetType="{x:Type TabItem}">
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabItem}">
          <Border x:Name="Root"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="0,0,0,2"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CustomTabItemLargeStyle" TargetType="{x:Type TabItem}">
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabItem}">
          <Border x:Name="Root"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="0,0,0,2"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CustomTabItemSideStyle" TargetType="{x:Type TabItem}">
    <Setter Property="Width" Value="138"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabItem}">
          <Border x:Name="Root"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="2,0,0,0"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource SoftBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type container:CustomTabs}">
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource CustomTabItemStyle}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type container:CustomTabs}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,2">
              <ItemsPresenter/>
            </Border>
            <ContentPresenter Grid.Row="1"
                              Margin="0,12,0,0"
                              ContentSource="SelectedContent"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Size" Value="Small">
        <Setter Property="ItemContainerStyle" Value="{StaticResource CustomTabItemSmallStyle}"/>
      </Trigger>
      <Trigger Property="Size" Value="Large">
        <Setter Property="ItemContainerStyle" Value="{StaticResource CustomTabItemLargeStyle}"/>
      </Trigger>
      <Trigger Property="TabStripPlacement" Value="Left">
        <Setter Property="ItemContainerStyle" Value="{StaticResource CustomTabItemSideStyle}"/>
        <Setter Property="ItemsPanel">
          <Setter.Value>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical"/>
            </ItemsPanelTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type container:CustomTabs}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,2,0">
                  <ItemsPresenter/>
                </Border>
                <ContentPresenter Grid.Column="1"
                                  Margin="16,0,0,0"
                                  ContentSource="SelectedContent"/>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============ CustomCollapse ============ -->

  <Style x:Key="CustomCollapseHeaderToggle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="8"
                  Padding="12,10"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type container:CustomCollapse}">
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type container:CustomCollapse}">
          <Border Background="{DynamicResource PaperBrush}"
                  BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="2"
                  CornerRadius="12"
                  ClipToBounds="True">
            <ItemsPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type container:CustomCollapseItem}">
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type container:CustomCollapseItem}">
          <Border BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="0,0,0,2"
                  SnapsToDevicePixels="True">
            <StackPanel>
              <ToggleButton x:Name="HeaderToggle"
                            Style="{StaticResource CustomCollapseHeaderToggle}"
                            IsChecked="{Binding Expanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="Chevron"
                             Text="›"
                             Margin="0,0,8,0"
                             FontSize="14"
                             FontWeight="Bold"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1"
                             Text="{TemplateBinding Header}"
                             FontWeight="Bold"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center"/>
                  <ContentPresenter Grid.Column="2"
                                    Content="{TemplateBinding HeaderExtra}"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"/>
                </Grid>
              </ToggleButton>
              <Border x:Name="Body"
                      Padding="12,4,12,14"
                      Visibility="Collapsed">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
              </Border>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Expanded" Value="True">
              <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Chevron" Property="Text" Value="⌄"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ CustomPagination ============ -->

  <Style x:Key="CustomPageButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Margin" Value="2,0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="2"
                  CornerRadius="8"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CustomPageButtonCurrentStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CustomPageButtonStyle}">
    <Setter Property="Background" Value="{DynamicResource SoftBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
  </Style>

  <Style x:Key="CustomPageSizeItemStyle" TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Border x:Name="ItemRoot"
                  Background="{TemplateBinding Background}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}"
                  Margin="2,1"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource SoftBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ItemRoot" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CustomPageSizeToggleStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="ClickMode" Value="Press"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Background="Transparent" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 每页条数：可输入的下拉框，输入值在 CustomPagination 中按区间钳制。 -->
  <Style x:Key="CustomPageSizeComboBoxStyle" TargetType="{x:Type ComboBox}">
    <Setter Property="Width" Value="84"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="IsEditable" Value="True"/>
    <Setter Property="StaysOpenOnEdit" Value="True"/>
    <Setter Property="IsTextSearchEnabled" Value="False"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource CustomPageSizeItemStyle}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="22"/>
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    SnapsToDevicePixels="True"/>
            <TextBox x:Name="PART_EditableTextBox"
                     Grid.Column="0"
                     Height="Auto"
                     Margin="{TemplateBinding Padding}"
                     Padding="0"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{TemplateBinding Foreground}"
                     CaretBrush="{DynamicResource InkBrush}"
                     SelectionBrush="{DynamicResource PrimaryBrush}"
                     FontFamily="{TemplateBinding FontFamily}"
                     FontSize="{TemplateBinding FontSize}"
                     VerticalContentAlignment="Center"
                     VerticalAlignment="Center"
                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Path Grid.Column="1"
                  Width="8"
                  Height="5"
                  Data="M 1,1 L 4,4 L 7,1"
                  Stroke="{DynamicResource MutedBrush}"
                  StrokeThickness="1.6"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  IsHitTestVisible="False"/>
            <ToggleButton x:Name="PART_DropDown"
                          Grid.Column="1"
                          Style="{StaticResource CustomPageSizeToggleStyle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <Popup x:Name="PART_Popup"
                   Grid.ColumnSpan="2"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   Focusable="False">
              <Border Background="{DynamicResource PaperBrush}"
                      BorderBrush="{DynamicResource EdgeBrush}"
                      BorderThickness="2"
                      CornerRadius="8"
                      Margin="0,4,0,0"
                      Padding="2"
                      MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="240"
                      SnapsToDevicePixels="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type container:CustomPagination}">
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type container:CustomPagination}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ComboBox x:Name="PART_PageSize"
                      Style="{StaticResource CustomPageSizeComboBoxStyle}"
                      Margin="0,0,6,0"/>
            <TextBlock Text="条/页"
                       Margin="0,0,10,0"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>
            <Button x:Name="PART_Prev"
                    Content="‹"
                    Style="{StaticResource CustomPageButtonStyle}"/>
            <StackPanel x:Name="PART_Pages"
                        Orientation="Horizontal"
                        Margin="4,0"/>
            <Button x:Name="PART_Next"
                    Content="›"
                    Style="{StaticResource CustomPageButtonStyle}"/>
            <TextBlock x:Name="PART_Info"
                       Margin="10,0,0,0"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ CustomSteps / CustomStep ============ -->

  <Style TargetType="{x:Type container:CustomStep}">
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Padding" Value="0,0,16,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type container:CustomStep}">
          <StackPanel Margin="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="Badge"
                      Width="28"
                      Height="28"
                      CornerRadius="14"
                      BorderThickness="2"
                      BorderBrush="{DynamicResource EdgeBrush}"
                      Background="{DynamicResource PaperBrush}"
                      SnapsToDevicePixels="True">
                <TextBlock x:Name="BadgeText"
                           Text="{TemplateBinding BadgeText}"
                           FontSize="12"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}"/>
              </Border>
              <Border x:Name="Connector"
                      Grid.Column="1"
                      Height="2"
                      Margin="10,0,0,0"
                      Background="{DynamicResource EdgeBrush}"
                      VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="TitleText"
                       Text="{TemplateBinding Title}"
                       Margin="0,8,0,0"
                       FontSize="13"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource InkBrush}"/>
            <TextBlock x:Name="DescriptionText"
                       Text="{TemplateBinding Description}"
                       Margin="0,4,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}"/>
            <ContentPresenter Margin="0,8,0,0"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Status" Value="Process">
              <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
              <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SoftBrush}"/>
              <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="Status" Value="Finish">
              <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
              <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SuccessBrush}"/>
              <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource PaperBrush}"/>
              <Setter TargetName="Connector" Property="Background" Value="{DynamicResource SuccessBrush}"/>
            </Trigger>
            <Trigger Property="Status" Value="Error">
              <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
              <Setter TargetName="Badge" Property="Background" Value="{DynamicResource DangerBrush}"/>
              <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource PaperBrush}"/>
            </Trigger>
            <Trigger Property="IsLast" Value="True">
              <Setter TargetName="Connector" Property="Visibility" Value="Hidden"/>
            </Trigger>
            <Trigger Property="Description" Value="">
              <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Title" Value="">
              <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ CustomTimeline / CustomTimelineItem ============ -->

  <Style TargetType="{x:Type container:CustomTimelineItem}">
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Margin" Value="0,0,0,16"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type container:CustomTimelineItem}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border x:Name="Line"
                    Grid.RowSpan="2"
                    Width="2"
                    Margin="0,10,0,-26"
                    Background="{DynamicResource EdgeBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"/>
            <Border x:Name="Dot"
                    Width="12"
                    Height="12"
                    CornerRadius="6"
                    Margin="0,4,0,0"
                    BorderThickness="2"
                    BorderBrush="{TemplateBinding ToneBrush}"
                    Background="{DynamicResource PaperBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    SnapsToDevicePixels="True"/>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock x:Name="TitleText"
                         Text="{TemplateBinding Title}"
                         FontWeight="Bold"
                         FontSize="13"
                         TextWrapping="Wrap"/>
              <ContentPresenter Margin="0,4,0,0"/>
              <TextBlock x:Name="TimeText"
                         Text="{TemplateBinding Time}"
                         Margin="0,4,0,0"
                         FontSize="12"
                         Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsLast" Value="True">
              <Setter TargetName="Line" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Time" Value="">
              <Setter TargetName="TimeText" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Title" Value="">
              <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
