<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:inputs="clr-namespace:Sim.Admin.Wpf.Client.Controls.Inputs">

  <!-- 表单控件族：CustomInput / CustomTextarea / CustomPasswordInput / CustomInputNumber / CustomSelect /
       CustomCheckBox / CustomRadio / CustomRadioButton / CustomFormItem。
       视觉约束：不使用任何投影，层级只由 2px EdgeBrush 描边、圆角与语义色表达；
       颜色全部使用 DynamicResource，尺寸使用 CustomControlSize 三档（30 / 36 / 42，圆角 8 / 10 / 12）。 -->

  <!-- ============ 模板内部复用样式（仅本字典） ============ -->

  <Style x:Key="CustomInputClearButton" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="20"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Background" Value="{DynamicResource SoftBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CustomInputNumberStepButton" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Background="{TemplateBinding Background}" CornerRadius="5" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Background" Value="{DynamicResource SoftBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CustomInputNumberEditor" TargetType="{x:Type TextBox}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}"/>
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <ScrollViewer x:Name="PART_ContentHost"
                        SnapsToDevicePixels="True"
                        VerticalScrollBarVisibility="Hidden"
                        HorizontalScrollBarVisibility="Hidden"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CustomSelectToggleButton" TargetType="{x:Type ToggleButton}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="ClickMode" Value="Press"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Background="Transparent" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CustomSelectItem" TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Border x:Name="ItemRoot"
                  Background="{TemplateBinding Background}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}"
                  Margin="2,1"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource SoftBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ItemRoot" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CustomPasswordBox" TargetType="{x:Type PasswordBox}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="12,5"/>
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type PasswordBox}">
          <ScrollViewer x:Name="PART_ContentHost"
                        SnapsToDevicePixels="True"
                        VerticalScrollBarVisibility="Hidden"
                        HorizontalScrollBarVisibility="Hidden"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ CustomInput ============ -->

  <Style TargetType="{x:Type inputs:CustomInput}">
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="12,5"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type inputs:CustomInput}">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10"
                  SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ScrollViewer x:Name="PART_ContentHost"
                            Grid.Column="0"
                            SnapsToDevicePixels="True"
                            VerticalScrollBarVisibility="Hidden"
                            HorizontalScrollBarVisibility="Hidden"/>
              <TextBlock x:Name="PlaceholderText"
                         Grid.Column="0"
                         Text="{TemplateBinding Placeholder}"
                         Margin="{TemplateBinding Padding}"
                         Foreground="{DynamicResource MutedBrush}"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Left"
                         TextTrimming="CharacterEllipsis"
                         IsHitTestVisible="False"
                         Visibility="Collapsed"/>
              <Button x:Name="ClearButton"
                      Grid.Column="1"
                      Content="×"
                      Style="{StaticResource CustomInputClearButton}"
                      Command="{x:Static inputs:CustomInput.ClearCommand}"
                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                      VerticalAlignment="Center"
                      Visibility="Visible"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
              <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="AllowClear" Value="False">
              <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Size" Value="Small">
              <Setter TargetName="Root" Property="CornerRadius" Value="8"/>
            </Trigger>
            <Trigger Property="Size" Value="Large">
              <Setter TargetName="Root" Property="CornerRadius" Value="12"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Size" Value="Small">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="FontSize" Value="12"/>
      </Trigger>
      <Trigger Property="Size" Value="Large">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="14"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
      </Trigger>
      <Trigger Property="IsInvalid" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45"/>
        <Setter Property="Cursor" Value="Arrow"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============ CustomTextarea ============ -->

  <Style TargetType="{x:Type inputs:CustomTextarea}">
    <Setter Property="MinHeight" Value="88"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type inputs:CustomTextarea}">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10"
                  SnapsToDevicePixels="True">
            <Grid>
              <ScrollViewer x:Name="PART_ContentHost"
                            SnapsToDevicePixels="True"
                            HorizontalScrollBarVisibility="Disabled"/>
              <TextBlock x:Name="PlaceholderText"
                         Text="{TemplateBinding Placeholder}"
                         Margin="{TemplateBinding Padding}"
                         Foreground="{DynamicResource MutedBrush}"
                         VerticalAlignment="Top"
                         HorizontalAlignment="Left"
                         TextWrapping="Wrap"
                         IsHitTestVisible="False"
                         Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="Size" Value="Small">
              <Setter TargetName="Root" Property="CornerRadius" Value="8"/>
            </Trigger>
            <Trigger Property="Size" Value="Large">
              <Setter TargetName="Root" Property="CornerRadius" Value="12"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Size" Value="Small">
        <Setter Property="MinHeight" Value="72"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="12"/>
      </Trigger>
      <Trigger Property="Size" Value="Large">
        <Setter Property="MinHeight" Value="110"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontSize" Value="14"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
      </Trigger>
      <Trigger Property="IsInvalid" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============ CustomPasswordInput ============ -->

  <Style TargetType="{x:Type inputs:CustomPasswordInput}">
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinWidth" Value="0"/>
    <!-- 组合控件本身不参与 Tab 焦点，Tab 直接落到模板内的 PasswordBox。 -->
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Padding" Value="12,5"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type inputs:CustomPasswordInput}">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10"
                  SnapsToDevicePixels="True">
            <Grid>
              <PasswordBox x:Name="PART_Password"
                           Style="{StaticResource CustomPasswordBox}"
                           VerticalAlignment="Stretch"/>
              <TextBlock x:Name="PlaceholderText"
                         Text="{TemplateBinding Placeholder}"
                         Margin="{TemplateBinding Padding}"
                         Foreground="{DynamicResource MutedBrush}"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Left"
                         TextTrimming="CharacterEllipsis"
                         IsHitTestVisible="False"
                         Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Size" Value="Small">
              <Setter TargetName="Root" Property="CornerRadius" Value="8"/>
              <Setter TargetName="PART_Password" Property="Padding" Value="10,3"/>
              <Setter TargetName="PART_Password" Property="FontSize" Value="12"/>
            </Trigger>
            <Trigger Property="Size" Value="Large">
              <Setter TargetName="Root" Property="CornerRadius" Value="12"/>
              <Setter TargetName="PART_Password" Property="Padding" Value="16,8"/>
              <Setter TargetName="PART_Password" Property="FontSize" Value="14"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Size" Value="Small">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="FontSize" Value="12"/>
      </Trigger>
      <Trigger Property="Size" Value="Large">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="14"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
      </Trigger>
      <Trigger Property="IsInvalid" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============ CustomInputNumber ============ -->

  <Style TargetType="{x:Type inputs:CustomInputNumber}">
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="12,5"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type inputs:CustomInputNumber}">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10"
                  SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="0">
                <TextBox x:Name="PART_Editor"
                         Style="{StaticResource CustomInputNumberEditor}"
                         VerticalAlignment="Stretch"/>
                <TextBlock x:Name="PlaceholderText"
                           Text="{TemplateBinding Placeholder}"
                           Margin="10,0"
                           Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>
              </Grid>
              <Button x:Name="PART_Decrease"
                      Grid.Column="1"
                      Content="−"
                      Style="{StaticResource CustomInputNumberStepButton}"
                      VerticalAlignment="Center"
                      Margin="0,0,2,0"/>
              <Button x:Name="PART_Increase"
                      Grid.Column="2"
                      Content="+"
                      Style="{StaticResource CustomInputNumberStepButton}"
                      VerticalAlignment="Center"
                      Margin="0,0,4,0"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Size" Value="Small">
              <Setter TargetName="Root" Property="CornerRadius" Value="8"/>
              <Setter TargetName="PART_Editor" Property="FontSize" Value="12"/>
            </Trigger>
            <Trigger Property="Size" Value="Large">
              <Setter TargetName="Root" Property="CornerRadius" Value="12"/>
              <Setter TargetName="PART_Editor" Property="FontSize" Value="14"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Size" Value="Small">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="FontSize" Value="12"/>
      </Trigger>
      <Trigger Property="Size" Value="Large">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="14"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
      </Trigger>
      <Trigger Property="IsInvalid" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============ CustomSelect ============ -->

  <Style TargetType="{x:Type inputs:CustomSelect}">
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="12,5"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource CustomSelectItem}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type inputs:CustomSelect}">
          <Grid>
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="SelectionHost"
                                  Grid.Column="0"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"/>
                <TextBlock x:Name="PlaceholderText"
                           Grid.Column="0"
                           Text="{TemplateBinding Placeholder}"
                           Margin="{TemplateBinding Padding}"
                           Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>
                <Path Grid.Column="1"
                      Width="10"
                      Height="6"
                      Data="M 1,1 L 5,5 L 9,1"
                      Stroke="{DynamicResource MutedBrush}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Stretch="None"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0"
                      IsHitTestVisible="False"/>
              </Grid>
            </Border>
            <ToggleButton x:Name="Toggle"
                          Style="{StaticResource CustomSelectToggleButton}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          Focusable="False"
                          ClickMode="Press"/>
            <Popup x:Name="PART_Popup"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   Focusable="False">
              <Border Background="{DynamicResource PaperBrush}"
                      BorderBrush="{DynamicResource EdgeBrush}"
                      BorderThickness="2"
                      CornerRadius="10"
                      Margin="0,4,0,0"
                      Padding="2"
                      MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="280"
                      SnapsToDevicePixels="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="SelectedIndex" Value="-1">
              <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="Size" Value="Small">
              <Setter TargetName="Root" Property="CornerRadius" Value="8"/>
            </Trigger>
            <Trigger Property="Size" Value="Large">
              <Setter TargetName="Root" Property="CornerRadius" Value="12"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Size" Value="Small">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="FontSize" Value="12"/>
      </Trigger>
      <Trigger Property="Size" Value="Large">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="14"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
      </Trigger>
      <Trigger Property="IsDropDownOpen" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
      </Trigger>
      <Trigger Property="IsInvalid" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============ CustomCheckBox ============ -->

  <Style TargetType="{x:Type inputs:CustomCheckBox}">
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type inputs:CustomCheckBox}">
          <Border x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="Box"
                      Width="18"
                      Height="18"
                      Background="{DynamicResource PaperBrush}"
                      BorderBrush="{DynamicResource EdgeBrush}"
                      BorderThickness="2"
                      CornerRadius="5"
                      VerticalAlignment="Center"
                      SnapsToDevicePixels="True">
                <Grid>
                  <Path x:Name="CheckMark"
                        Data="M 2,6 L 5,9 L 11,2"
                        Stroke="{DynamicResource PrimaryTextBrush}"
                        StrokeThickness="2"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="None"
                        Visibility="Collapsed"/>
                  <Rectangle x:Name="DashMark"
                             Width="8"
                             Height="2"
                             RadiusX="1"
                             RadiusY="1"
                             Fill="{DynamicResource PrimaryTextBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="Collapsed"/>
                </Grid>
              </Border>
              <ContentPresenter x:Name="LabelHost"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                RecognizesAccessKey="True"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
              <Setter TargetName="DashMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="Size" Value="Small">
              <Setter TargetName="Box" Property="Width" Value="16"/>
              <Setter TargetName="Box" Property="Height" Value="16"/>
            </Trigger>
            <Trigger Property="Size" Value="Large">
              <Setter TargetName="Box" Property="Width" Value="20"/>
              <Setter TargetName="Box" Property="Height" Value="20"/>
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="LabelHost" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Content" Value="">
              <Setter TargetName="LabelHost" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Size" Value="Small">
        <Setter Property="FontSize" Value="12"/>
      </Trigger>
      <Trigger Property="Size" Value="Large">
        <Setter Property="FontSize" Value="14"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 原生 CheckBox（DataGrid 复选列、字段编辑器）：沿用 n-checkbox 的方框样式。
       DataGridCheckBoxColumn 会应用列级 ElementStyle，复选列需显式引用该 keyed 样式。 -->
  <Style x:Key="NaiveCheckBoxStyle" TargetType="{x:Type CheckBox}">
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Border Background="Transparent" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="Box"
                      Width="18"
                      Height="18"
                      Background="{DynamicResource PaperBrush}"
                      BorderBrush="{DynamicResource EdgeBrush}"
                      BorderThickness="2"
                      CornerRadius="5"
                      VerticalAlignment="Center"
                      SnapsToDevicePixels="True">
                <Grid>
                  <Path x:Name="CheckMark"
                        Data="M 2,6 L 5,9 L 11,2"
                        Stroke="{DynamicResource PrimaryTextBrush}"
                        StrokeThickness="2"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="None"
                        Visibility="Collapsed"/>
                  <Rectangle x:Name="DashMark"
                             Width="8"
                             Height="2"
                             RadiusX="1"
                             RadiusY="1"
                             Fill="{DynamicResource PrimaryTextBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="Collapsed"/>
                </Grid>
              </Border>
              <ContentPresenter x:Name="LabelHost"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                RecognizesAccessKey="True"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
              <Setter TargetName="DashMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="LabelHost" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Content" Value="">
              <Setter TargetName="LabelHost" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource NaiveCheckBoxStyle}"/>

  <!-- 表格中的状态标志（内置、当前会话、在线、已读等）只展示，不接受鼠标或键盘交互。 -->
  <Style x:Key="NaiveStatusCheckBoxStyle" TargetType="{x:Type CheckBox}"
         BasedOn="{StaticResource NaiveCheckBoxStyle}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Cursor" Value="Arrow"/>
  </Style>

  <!-- ============ CustomRadio ============ -->

  <Style TargetType="{x:Type inputs:CustomRadio}">
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type inputs:CustomRadio}">
          <Border x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="Circle"
                      Width="18"
                      Height="18"
                      Background="{DynamicResource PaperBrush}"
                      BorderBrush="{DynamicResource EdgeBrush}"
                      BorderThickness="2"
                      CornerRadius="9"
                      VerticalAlignment="Center"
                      SnapsToDevicePixels="True">
                <Ellipse x:Name="Dot"
                         Width="8"
                         Height="8"
                         Fill="{DynamicResource PrimaryBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="Collapsed"/>
              </Border>
              <ContentPresenter x:Name="LabelHost"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                RecognizesAccessKey="True"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
              <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="Size" Value="Small">
              <Setter TargetName="Circle" Property="Width" Value="16"/>
              <Setter TargetName="Circle" Property="Height" Value="16"/>
              <Setter TargetName="Circle" Property="CornerRadius" Value="8"/>
              <Setter TargetName="Dot" Property="Width" Value="7"/>
              <Setter TargetName="Dot" Property="Height" Value="7"/>
            </Trigger>
            <Trigger Property="Size" Value="Large">
              <Setter TargetName="Circle" Property="Width" Value="20"/>
              <Setter TargetName="Circle" Property="Height" Value="20"/>
              <Setter TargetName="Circle" Property="CornerRadius" Value="10"/>
              <Setter TargetName="Dot" Property="Width" Value="9"/>
              <Setter TargetName="Dot" Property="Height" Value="9"/>
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="LabelHost" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Content" Value="">
              <Setter TargetName="LabelHost" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Size" Value="Small">
        <Setter Property="FontSize" Value="12"/>
      </Trigger>
      <Trigger Property="Size" Value="Large">
        <Setter Property="FontSize" Value="14"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============ CustomRadioButton ============ -->

  <Style TargetType="{x:Type inputs:CustomRadioButton}">
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="12,5"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type inputs:CustomRadioButton}">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10"
                  SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                              RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Size" Value="Small">
              <Setter TargetName="Root" Property="CornerRadius" Value="8"/>
            </Trigger>
            <Trigger Property="Size" Value="Large">
              <Setter TargetName="Root" Property="CornerRadius" Value="12"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Size" Value="Small">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="FontSize" Value="12"/>
      </Trigger>
      <Trigger Property="Size" Value="Large">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="14"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{DynamicResource SoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Cursor" Value="Arrow"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============ CustomFormItem ============ -->

  <Style TargetType="{x:Type inputs:CustomFormItem}">
    <Setter Property="FontFamily" Value="Cascadia Code,Microsoft YaHei UI,Consolas"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type inputs:CustomFormItem}">
          <StackPanel>
            <Grid x:Name="LabelRow" Margin="0,0,0,6">
              <StackPanel Orientation="Horizontal"
                          MinWidth="{TemplateBinding LabelWidth}"
                          HorizontalAlignment="Left">
                <TextBlock Text="{TemplateBinding Label}"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource InkBrush}"/>
                <TextBlock x:Name="RequiredMark"
                           Text=" *"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DangerBrush}"
                           Visibility="Collapsed"/>
              </StackPanel>
            </Grid>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                              HorizontalAlignment="Stretch"/>
            <TextBlock x:Name="FeedbackText"
                       Text="{TemplateBinding Feedback}"
                       Margin="0,6,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap"
                       Visibility="Visible"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Required" Value="True">
              <Setter TargetName="RequiredMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="Feedback" Value="">
              <Setter TargetName="FeedbackText" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsInvalid" Value="True">
              <Setter TargetName="FeedbackText" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Label" Value=""/>
                <Condition Property="Required" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="LabelRow" Property="Visibility" Value="Collapsed"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ CustomSwitch：二元开关 ============ -->

  <Style TargetType="{x:Type inputs:CustomSwitch}">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type inputs:CustomSwitch}">
          <Border x:Name="Track"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="2"
                  CornerRadius="11"
                  SnapsToDevicePixels="True">
            <Border x:Name="Thumb"
                    Width="14"
                    Height="14"
                    Margin="2"
                    CornerRadius="7"
                    Background="{TemplateBinding Foreground}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    SnapsToDevicePixels="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
              <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource PrimaryTextBrush}"/>
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
            <Trigger Property="Size" Value="Small">
              <Setter Property="Width" Value="36"/>
              <Setter Property="Height" Value="20"/>
              <Setter TargetName="Track" Property="CornerRadius" Value="10"/>
              <Setter TargetName="Thumb" Property="Width" Value="12"/>
              <Setter TargetName="Thumb" Property="Height" Value="12"/>
              <Setter TargetName="Thumb" Property="CornerRadius" Value="6"/>
            </Trigger>
            <Trigger Property="Size" Value="Large">
              <Setter Property="Width" Value="46"/>
              <Setter Property="Height" Value="26"/>
              <Setter TargetName="Track" Property="CornerRadius" Value="13"/>
              <Setter TargetName="Thumb" Property="Width" Value="18"/>
              <Setter TargetName="Thumb" Property="Height" Value="18"/>
              <Setter TargetName="Thumb" Property="CornerRadius" Value="9"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
