<Window x:Class="Sim.Admin.Wpf.Client.Features.Management.SelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Sim.Admin.Wpf.Client.Controls"
        xmlns:inputs="clr-namespace:Sim.Admin.Wpf.Client.Controls.Inputs"
        Width="480" Height="620" MinHeight="400" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource InkBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ListBox x:Name="OptionsList" Background="{DynamicResource PaperBrush}"
             BorderBrush="{DynamicResource EdgeBrush}" ScrollViewer.CanContentScroll="True">
      <ListBox.ItemContainerStyle>
        <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"/>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <inputs:CustomCheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                 Padding="8,6"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TreeView x:Name="OptionsTree" Visibility="Collapsed" Background="{DynamicResource PaperBrush}"
              BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="2" Padding="4"
              ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <TreeView.ItemContainerStyle>
        <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
          <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"/>
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>
      </TreeView.ItemContainerStyle>
      <TreeView.ItemTemplate>
        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
          <!-- 复选框不能拉伸整行：获得焦点时 BringIntoView 会把超宽的行横向滚动到左边缘。 -->
          <inputs:CustomCheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                 IsThreeState="True" Padding="4,3"
                                 HorizontalAlignment="Left"
                                 Click="OptionClick"/>
        </HierarchicalDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <inputs:CustomInput x:Name="FilterBox" Height="42" Margin="0,0,12,0"
                          Placeholder="筛选" AllowClear="True" TextChanged="FilterChanged"
                          AutomationProperties.Name="筛选"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <controls:CustomButton Content="保存选择" Variant="Primary" Click="SaveClick"/>
        <controls:CustomButton Content="取消" Click="CancelClick" Margin="8,0,0,0"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
