<UserControl x:Class="Sim.Admin.Wpf.Client.Features.Management.ManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sim.Admin.Wpf.Client.Controls"
             xmlns:inputs="clr-namespace:Sim.Admin.Wpf.Client.Controls.Inputs"
             xmlns:container="clr-namespace:Sim.Admin.Wpf.Client.Controls.Container">
  <UserControl.Resources>
    <DataTemplate x:Key="RowActionsTemplate">
      <ItemsControl ItemsSource="{Binding Actions}" HorizontalAlignment="Right">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <controls:CustomButton Content="{Binding Label}" Tag="{Binding}"
                                   Height="30" Size="Small" Margin="4,0,0,0" Padding="8,3"
                                   Click="RowActionClick">
              <controls:CustomButton.Style>
                <Style TargetType="{x:Type controls:CustomButton}"
                       BasedOn="{StaticResource {x:Type controls:CustomButton}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Danger}" Value="True">
                      <Setter Property="Variant" Value="Danger"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </controls:CustomButton.Style>
            </controls:CustomButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>
  </UserControl.Resources>
  <controls:CustomCard x:Name="Card" Margin="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,12">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <controls:CustomButton x:Name="CreateButton" Content="新建" Variant="Primary" Click="CreateClick" Height="34" Margin="8,0,0,0"/>
          <controls:CustomButton x:Name="DeleteButton" Content="删除" Variant="Danger" Click="DeleteClick" Height="34" Margin="8,0,0,0"/>
          <StackPanel x:Name="RowActions" Orientation="Horizontal"/>
          <controls:CustomButton Content="刷新" Click="RefreshClick" Height="34" Margin="8,0,0,0"/>
        </StackPanel>
        <inputs:CustomInput x:Name="SearchBox" Width="210" Height="34" Placeholder="筛选当前页"
                            AllowClear="True" TextChanged="SearchChanged"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="筛选当前页"/>
      </DockPanel>
      <controls:CustomDataGrid x:Name="Records" Grid.Row="1" EnableSelection="True" RowKeyPath="Id"
                              SelectionChanged="SelectionChanged" Sorting="RecordsSorting"/>
      <DockPanel Grid.Row="2" Margin="0,12,0,0">
        <container:CustomPagination x:Name="Pager" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Margin="12,0,0,0"/>
        <TextBlock x:Name="Status" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
      </DockPanel>
    </Grid>
  </controls:CustomCard>
</UserControl>
