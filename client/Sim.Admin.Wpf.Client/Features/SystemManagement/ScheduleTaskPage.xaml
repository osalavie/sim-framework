<UserControl x:Class="Sim.Admin.Wpf.Client.Features.SystemManagement.ScheduleTaskPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sim.Admin.Wpf.Client.Controls">
  <controls:CustomCard Margin="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
        <controls:CustomButton Content="刷新" Height="34" Margin="0,0,8,0" Click="RefreshClick"/>
        <controls:CustomButton Content="新建" Variant="Primary" Height="34" Margin="0,0,8,0" Click="CreateClick"/>
        <controls:CustomButton x:Name="TriggerButton" Content="立即执行" Height="34" Margin="0,0,8,0" Click="TriggerClick"/>
        <controls:CustomButton x:Name="DeleteButton" Content="删除" Variant="Danger" Height="34" Click="DeleteClick"/>
      </StackPanel>
      <controls:CustomDataGrid x:Name="Records" Grid.Row="1" EnableSelection="True" RowKeyPath="Id"
                            SelectionChanged="SelectionChanged" MouseDoubleClick="RecordsDoubleClick">
        <DataGrid.Columns>
          <DataGridTextColumn Header="名称" Binding="{Binding DisplayName}" Width="*" MinWidth="120"/>
          <DataGridTextColumn Header="类型" Binding="{Binding TaskType}" Width="90"/>
          <DataGridTextColumn Header="Cron" Binding="{Binding CronExpression}" Width="130"/>
          <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="60" IsReadOnly="True"
                                  ElementStyle="{StaticResource NaiveStatusCheckBoxStyle}"/>
          <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90"/>
          <DataGridTextColumn Header="上次运行" Binding="{Binding PreviousRunTime, StringFormat=yyyy-MM-dd HH:mm}" Width="160"/>
          <DataGridTextColumn Header="下次运行" Binding="{Binding NextRunTime, StringFormat=yyyy-MM-dd HH:mm}" Width="160"/>
          <DataGridCheckBoxColumn Header="内置" Binding="{Binding IsBuiltIn}" Width="60" IsReadOnly="True"
                                  ElementStyle="{StaticResource NaiveStatusCheckBoxStyle}"/>
        </DataGrid.Columns>
      </controls:CustomDataGrid>
      <TextBlock x:Name="Status" Grid.Row="2" Foreground="{DynamicResource MutedBrush}"
                 TextWrapping="Wrap" Margin="0,12,0,0"/>
    </Grid>
  </controls:CustomCard>
</UserControl>
