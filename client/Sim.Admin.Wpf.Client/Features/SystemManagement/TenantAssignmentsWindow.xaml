<Window x:Class="Sim.Admin.Wpf.Client.Features.SystemManagement.TenantAssignmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Sim.Admin.Wpf.Client.Controls"
        xmlns:container="clr-namespace:Sim.Admin.Wpf.Client.Controls.Container"
        Title="租户分配" Width="780" Height="620" MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource InkBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <container:CustomTabs Grid.Row="0">
      <TabItem Header="模块">
        <controls:CustomDataGrid x:Name="ModulesGrid">
          <DataGrid.Columns>
            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="顺序" Binding="{Binding Order}" Width="80"/>
            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="70" IsReadOnly="True"
                                    ElementStyle="{StaticResource NaiveStatusCheckBoxStyle}"/>
          </DataGrid.Columns>
        </controls:CustomDataGrid>
      </TabItem>
      <TabItem Header="路由">
        <controls:CustomDataGrid x:Name="RoutesGrid">
          <DataGrid.Columns>
            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="200"/>
            <DataGridCheckBoxColumn Header="菜单" Binding="{Binding Menu}" Width="70" IsReadOnly="True"
                                    ElementStyle="{StaticResource NaiveStatusCheckBoxStyle}"/>
          </DataGrid.Columns>
        </controls:CustomDataGrid>
      </TabItem>
      <TabItem Header="权限">
        <controls:CustomDataGrid x:Name="PermissionsGrid">
          <DataGrid.Columns>
            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="权限码" Binding="{Binding Code}" Width="260"/>
          </DataGrid.Columns>
        </controls:CustomDataGrid>
      </TabItem>
    </container:CustomTabs>
    <controls:CustomButton Grid.Row="1" Content="关闭" HorizontalAlignment="Right" Width="90"
                        Margin="0,14,0,0" Click="CloseClick"/>
  </Grid>
</Window>
