<UserControl x:Class="Sim.Admin.Wpf.Client.Features.SystemManagement.OrganizationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sim.Admin.Wpf.Client.Controls">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="350"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <controls:CustomCard Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
      <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <controls:CustomButton Content="新建根部门" Height="32" Margin="0,0,6,6" Click="CreateRootClick"/>
          <controls:CustomButton x:Name="AddChildButton" Content="新建子部门" Height="32" Margin="0,0,6,6" Click="CreateChildClick"/>
          <controls:CustomButton x:Name="EditButton" Content="编辑" Height="32" Margin="0,0,6,6" Click="EditClick"/>
          <controls:CustomButton x:Name="DeleteButton" Content="删除" Variant="Danger" Height="32" Margin="0,0,6,6" Click="DeleteClick"/>
          <controls:CustomButton Content="刷新" Height="32" Margin="0,0,6,6" Click="RefreshClick"/>
        </WrapPanel>
        <TreeView x:Name="OrgTree" SelectedItemChanged="OrgSelected" Background="{DynamicResource PaperBrush}"
                  Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource EdgeBrush}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
              <TextBlock Text="{Binding Display}" Foreground="{DynamicResource InkBrush}" Padding="4,2"/>
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>
    </controls:CustomCard>

    <controls:CustomCard Grid.Row="0" Grid.Column="1">
      <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <controls:CustomButton x:Name="AddMemberButton" Content="添加成员" Height="32" Margin="0,0,6,6" Click="AddMemberClick"/>
          <controls:CustomButton x:Name="RemoveMemberButton" Content="移除成员" Variant="Danger" Height="32" Margin="0,0,6,6" Click="RemoveMemberClick"/>
          <controls:CustomButton Content="刷新成员" Height="32" Margin="0,0,6,6" Click="RefreshMembersClick"/>
        </WrapPanel>
        <controls:CustomDataGrid x:Name="Members" EnableSelection="True" RowKeyPath="Id" SelectionChanged="MemberSelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Header="用户" Binding="{Binding UserId}" Width="*" MinWidth="160"/>
            <DataGridTextColumn Header="职位" Binding="{Binding PositionName}" Width="160"/>
            <DataGridCheckBoxColumn Header="主组织" Binding="{Binding IsPrimary}" Width="80" IsReadOnly="True"
                                    ElementStyle="{StaticResource NaiveStatusCheckBoxStyle}"/>
            <DataGridTextColumn Header="来源" Binding="{Binding MembershipType}" Width="120"/>
          </DataGrid.Columns>
        </controls:CustomDataGrid>
      </DockPanel>
    </controls:CustomCard>

    <TextBlock x:Name="Status" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Left"
               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="4,10,0,0"/>
  </Grid>
</UserControl>
