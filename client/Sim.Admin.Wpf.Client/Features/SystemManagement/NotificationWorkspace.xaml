<UserControl x:Class="Sim.Admin.Wpf.Client.Features.SystemManagement.NotificationWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="170"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <ListBox x:Name="ModuleList" Grid.Column="0" SelectionChanged="ModuleChanged" Margin="0,8,8,8"
             Background="{DynamicResource PaperBrush}" Foreground="{DynamicResource InkBrush}"
             BorderBrush="{DynamicResource EdgeBrush}"/>
    <ContentControl x:Name="PageHost" Grid.Column="1"/>
  </Grid>
</UserControl>
