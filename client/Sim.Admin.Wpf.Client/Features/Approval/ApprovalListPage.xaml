<UserControl x:Class="Sim.Admin.Wpf.Client.Features.Approval.ApprovalListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sim.Admin.Wpf.Client.Controls"
             xmlns:inputs="clr-namespace:Sim.Admin.Wpf.Client.Controls.Inputs"
             xmlns:container="clr-namespace:Sim.Admin.Wpf.Client.Controls.Container">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel x:Name="FilterPanel" Orientation="Horizontal">
        <inputs:CustomInput x:Name="SearchBox" Width="210" Height="34" Placeholder="关键字"
                            AllowClear="True" AutomationProperties.Name="关键字" KeyDown="SearchKeyDown"/>
        <inputs:CustomInput x:Name="DefinitionFilter" Width="170" Height="34" Margin="8,0,0,0"
                            Placeholder="流程编码" AllowClear="True"
                            AutomationProperties.Name="流程编码" KeyDown="SearchKeyDown"/>
        <controls:CustomButton Content="查询" Height="34" Margin="8,0,0,0" Click="SearchClick"/>
        <controls:CustomButton Content="刷新" Height="34" Margin="8,0,0,0" Click="RefreshClick"/>
      </StackPanel>
      <StackPanel x:Name="ActionPanel" DockPanel.Dock="Right" Orientation="Horizontal"
                  HorizontalAlignment="Right"/>
    </DockPanel>

    <controls:CustomDataGrid x:Name="Records" Grid.Row="1" SelectionChanged="SelectionChanged"
                          MouseDoubleClick="RecordsDoubleClick"/>

    <DockPanel Grid.Row="2" Margin="0,12,0,0">
      <container:CustomPagination x:Name="Pager" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                  Margin="12,0,0,0"/>
      <TextBlock x:Name="Status" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                 TextWrapping="Wrap"/>
    </DockPanel>
  </Grid>
</UserControl>
