<Window x:Class="Sim.Admin.Wpf.Client.Features.Approval.ApprovalDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Sim.Admin.Wpf.Client.Controls"
        Title="审批详情" Width="980" Height="800" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource InkBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,6,0,12">
        <TextBlock x:Name="NumberText" FontWeight="Bold" Margin="0,0,16,0"/>
        <TextBlock x:Name="DefinitionText" Margin="0,0,16,0" Foreground="{DynamicResource MutedBrush}"/>
        <TextBlock x:Name="StatusText" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
      </WrapPanel>
    </StackPanel>

    <StackPanel x:Name="ActionBar" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
      <controls:CustomButton x:Name="HandleButton" Content="处理待办" Variant="Primary" Height="34"
                          Margin="0,0,8,0" Click="HandleClick"/>
      <controls:CustomButton x:Name="WithdrawButton" Content="撤回" Height="34" Margin="0,0,8,0" Click="WithdrawClick"/>
      <controls:CustomButton x:Name="ResubmitButton" Content="重新提交" Height="34" Margin="0,0,8,0" Click="ResubmitClick"/>
      <controls:CustomButton x:Name="UrgeButton" Content="催办" Height="34" Margin="0,0,8,0" Click="UrgeClick"/>
      <controls:CustomButton x:Name="UploadButton" Content="上传附件" Height="34" Margin="0,0,8,0" Click="UploadClick"/>
      <controls:CustomButton x:Name="TaskUploadButton" Content="上传待办附件" Height="34"
                          Margin="0,0,8,0" Click="TaskUploadClick"/>
      <controls:CustomButton x:Name="TerminateButton" Content="终止流程" Variant="Danger" Height="34"
                          Margin="0,0,8,0" Click="TerminateClick"/>
      <controls:CustomButton Content="刷新" Height="34" Click="RefreshClick"/>
    </StackPanel>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <controls:CustomCard Header="基本信息" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="流程" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock x:Name="DefinitionValue" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,12,8"/>
            <TextBlock Text="业务类型" Grid.Column="2" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock x:Name="BusinessValue" Grid.Column="3" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="发起人" Grid.Row="1" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock x:Name="InitiatorValue" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,12,8"/>
            <TextBlock Text="当前节点" Grid.Row="1" Grid.Column="2" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock x:Name="NodeValue" Grid.Row="1" Grid.Column="3" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="创建时间" Grid.Row="2" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock x:Name="CreatedValue" Grid.Row="2" Grid.Column="1" Margin="0,0,12,8"/>
            <TextBlock Text="完成时间" Grid.Row="2" Grid.Column="2" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock x:Name="CompletedValue" Grid.Row="2" Grid.Column="3" Margin="0,0,0,8"/>
            <TextBlock Text="业务对象" Grid.Row="3" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock x:Name="BusinessIdValue" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" TextWrapping="Wrap"/>
          </Grid>
        </controls:CustomCard>

        <controls:CustomCard Header="业务字段" Margin="0,0,0,12">
          <controls:CustomDataGrid x:Name="ContextGrid" Height="170">
            <DataGrid.Columns>
              <DataGridTextColumn Header="字段" Binding="{Binding DisplayName}" Width="220"/>
              <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*"/>
            </DataGrid.Columns>
          </controls:CustomDataGrid>
        </controls:CustomCard>

        <controls:CustomCard Header="节点进度" Margin="0,0,0,12">
          <controls:CustomDataGrid x:Name="NodeGrid" Height="210">
            <DataGrid.Columns>
              <DataGridTextColumn Header="顺序" Binding="{Binding SortOrder}" Width="60"/>
              <DataGridTextColumn Header="节点" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="类型" Binding="{Binding NodeType}" Width="140"/>
              <DataGridTextColumn Header="状态" Binding="{Binding Status, Converter={StaticResource ApprovalStatus}}" Width="110"/>
              <DataGridTextColumn Header="轮次" Binding="{Binding Round}" Width="60"/>
            </DataGrid.Columns>
          </controls:CustomDataGrid>
        </controls:CustomCard>

        <controls:CustomCard Header="处理记录" Margin="0,0,0,12">
          <controls:CustomDataGrid x:Name="RecordGrid" Height="210">
            <DataGrid.Columns>
              <DataGridTextColumn Header="时间" Binding="{Binding CreationTime, StringFormat=yyyy-MM-dd HH:mm}" Width="160"/>
              <DataGridTextColumn Header="节点" Binding="{Binding NodeName}" Width="130"/>
              <DataGridTextColumn Header="动作" Binding="{Binding Action, Converter={StaticResource ApprovalStatus}}" Width="110"/>
              <DataGridTextColumn Header="操作人" Binding="{Binding OperatorUserId}" Width="220"/>
              <DataGridTextColumn Header="目标用户" Binding="{Binding TargetUserId}" Width="220"/>
              <DataGridTextColumn Header="意见" Binding="{Binding Comment}" Width="*"/>
            </DataGrid.Columns>
          </controls:CustomDataGrid>
        </controls:CustomCard>

        <controls:CustomCard Header="附件" Margin="0,0,0,12">
          <DockPanel>
            <controls:CustomButton x:Name="DownloadButton" DockPanel.Dock="Right" Content="下载选中" Height="32"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,0,0,0"
                                Click="DownloadClick"/>
            <controls:CustomDataGrid x:Name="AttachmentGrid" Height="150" SelectionChanged="AttachmentSelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="*"/>
                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90"/>
                <DataGridTextColumn Header="上传人" Binding="{Binding UploaderUserId}" Width="240"/>
                <DataGridTextColumn Header="上传时间" Binding="{Binding CreationTime, StringFormat=yyyy-MM-dd HH:mm}" Width="160"/>
              </DataGrid.Columns>
            </controls:CustomDataGrid>
          </DockPanel>
        </controls:CustomCard>

        <controls:CustomCard Header="抄送">
          <controls:CustomDataGrid x:Name="CcGrid" Height="130">
            <DataGrid.Columns>
              <DataGridTextColumn Header="接收人" Binding="{Binding UserId}" Width="*"/>
              <DataGridTextColumn Header="收到时间" Binding="{Binding CreationTime, StringFormat=yyyy-MM-dd HH:mm}" Width="160"/>
              <DataGridTextColumn Header="已读时间" Binding="{Binding ReadAt, StringFormat=yyyy-MM-dd HH:mm}" Width="160"/>
            </DataGrid.Columns>
          </controls:CustomDataGrid>
        </controls:CustomCard>
      </StackPanel>
    </ScrollViewer>

    <TextBlock x:Name="Status" Grid.Row="3" Foreground="{DynamicResource MutedBrush}"
               TextWrapping="Wrap" Margin="0,10,0,0"/>
  </Grid>
</Window>
