<UserControl x:Class="Sim.Admin.Wpf.Client.Controls.CustomFormField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inputs="clr-namespace:Sim.Admin.Wpf.Client.Controls.Inputs"
             x:Name="Root">
  <StackPanel Margin="0,0,0,14">
    <TextBlock Text="{Binding Label, ElementName=Root}" FontWeight="Bold" Margin="0,0,0,6"/>
    <inputs:CustomInput x:Name="Input" Height="40"
                        Text="{Binding Value, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="{Binding MaxLength, ElementName=Root}"
                        IsInvalid="{Binding HasError, ElementName=Root}"
                        AutomationProperties.Name="{Binding Label, ElementName=Root}"/>
    <TextBlock x:Name="ErrorText"
               Text="{Binding ValidationError, ElementName=Root}"
               FontSize="12"
               TextWrapping="Wrap"
               Margin="0,4,0,0"
               Foreground="{DynamicResource DangerBrush}">
      <TextBlock.Style>
        <Style TargetType="{x:Type TextBlock}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasError, ElementName=Root}" Value="False">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
  </StackPanel>
</UserControl>
