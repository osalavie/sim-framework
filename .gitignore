# Environment files
.env
.env.*
!.env.example
# Backend per-environment config (may contain secrets): the repo only ships the shared
# appsettings.json and the appsettings.Example.json template. Every appsettings.{Environment}.json
# is local-only and is auto-generated from the template at startup when missing.
api/src/Sim.Admin.HttpApi.Host/appsettings.Development.json
api/src/Sim.Admin.HttpApi.Host/appsettings.Staging.json
api/src/Sim.Admin.HttpApi.Host/appsettings.Production.json
# Web frontend ships its env files (no secrets — only public API URLs and branding).
!web/.env
!web/.env.development
!web/.env.test
!web/.env.staging
!web/.env.production

