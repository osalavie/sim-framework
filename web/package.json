{
  "name": "@sim/web-framework",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/framework/index.d.ts",
      "import": "./dist/framework/index.js"
    },
    "./style.css": "./dist/assets/style.css",
    "./*": "./dist/*"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-s type-check \"build-only {@}\" --",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:test": "vite build --mode test",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "check:e2ee-workers": "node scripts/verify-e2ee-workers.mjs",
    "check:e2ee-device-cache": "node scripts/verify-e2ee-device-cache.mjs",
    "check:e2ee-passkeys": "node scripts/verify-e2ee-passkeys.mjs",
    "check:security": "node scripts/check-frontend-security.mjs",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "check:licenses": "node scripts/check-dependency-licenses.mjs frontend-licenses.json",
    "generate:api-types": "openapi-ts",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint . --max-warnings=0",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@hey-api/client-axios": "0.9.1",
    "@microsoft/signalr": "^10.0.0",
    "@tiptap/core": "^3.29.1",
    "@tiptap/extension-code-block-lowlight": "^3.29.1",
    "@tiptap/extension-image": "^3.29.1",
    "@tiptap/extension-placeholder": "^3.29.1",
    "@tiptap/extension-table": "^3.29.1",
    "@tiptap/markdown": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "@tiptap/vue-3": "^3.29.1",
    "@vicons/antd": "^0.13.0",
    "@vicons/carbon": "^0.13.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vue-flow/node-resizer": "^1.5.1",
    "animate.css": "^4.1.1",
    "axios": "^1.18.1",
    "dompurify": "^3.4.12",
    "fflate": "^0.8.3",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "lowlight": "^3.3.0",
    "marked": "^17.0.1",
    "naive-ui": "^2.43.1",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.0.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "@vitest/eslint-plugin": "^1.3.23",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.37.0",
    "eslint-plugin-playwright": "^2.2.2",
    "eslint-plugin-vue": "~10.6.2",
    "fast-check": "^4.3.0",
    "jiti": "^2.6.1",
    "jsdom": "^27.0.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "sass-embedded": "^1.93.3",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.9.0",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^30.0.0",
    "vfonts": "^0.1.0",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^4.0.16",
    "vue-tsc": "^3.1.1"
  }
}
