{
  "openapi": "3.0.4",
  "info": {
    "title": "Admin API",
    "description": "Admin API",
    "version": "v1"
  },
  "paths": {
    "/api/admin/client-localization": {
      "get": {
        "tags": [
          "ClientLocalization"
        ],
        "summary": "获取客户端本地化资源（当前文化、站点配置与本地化文本）。",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ClientLocalizationDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientLocalizationDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientLocalizationDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/setup/status": {
      "get": {
        "tags": [
          "Setup"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatusDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatusDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatusDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/setup/progress": {
      "get": {
        "tags": [
          "Setup"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/SetupProgressDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupProgressDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupProgressDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/setup/initialize": {
      "post": {
        "tags": [
          "Setup"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitializeSystemDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/InitializeSystemDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/InitializeSystemDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/admin/site-status": {
      "get": {
        "tags": [
          "SiteStatus"
        ],
        "summary": "获取当前站点运行状态（在其它 API 请求被拦截时仍保持可访问）。",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/SiteStatusDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteStatusDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteStatusDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClientLocalizationDto": {
        "type": "object",
        "properties": {
          "culture": {
            "type": "string",
            "description": "当前请求使用的语言文化名称（如 zh-CN、en）。",
            "nullable": true
          },
          "site": {
            "$ref": "#/components/schemas/ClientSiteConfigurationDto"
          },
          "texts": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "本地化文本字典（key 为资源名，value 为当前文化的翻译文本）。",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "后端拥有、供前端消费的本地化资源。"
      },
      "ClientSiteConfigurationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "站点名称。",
            "nullable": true
          },
          "defaultLanguage": {
            "type": "string",
            "description": "站点默认语言（zh-Hans 或 en）。",
            "nullable": true
          },
          "defaultTheme": {
            "type": "string",
            "description": "站点默认主题（auto、light 或 dark）。",
            "nullable": true
          },
          "registrationEnabled": {
            "type": "boolean",
            "description": "是否开放自助注册。"
          }
        },
        "additionalProperties": false,
        "description": "影响客户端展示的站点配置。"
      },
      "InitializeSystemDto": {
        "required": [
          "adminPassword",
          "adminUserName",
          "defaultLanguage",
          "defaultTheme",
          "siteName"
        ],
        "type": "object",
        "properties": {
          "adminUserName": {
            "maxLength": 28,
            "minLength": 3,
            "type": "string"
          },
          "adminPassword": {
            "maxLength": 128,
            "minLength": 6,
            "type": "string"
          },
          "adminNickName": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "siteName": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "defaultLanguage": {
            "maxLength": 16,
            "minLength": 0,
            "type": "string"
          },
          "defaultTheme": {
            "maxLength": 8,
            "minLength": 0,
            "type": "string"
          },
          "registrationEnabled": {
            "type": "boolean"
          },
          "loginMaxFailedAttempts": {
            "maximum": 20,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "lockoutDurationMinutes": {
            "maximum": 1440,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false,
        "description": "首次启动初始化请求。"
      },
      "SetupProgressDto": {
        "type": "object",
        "properties": {
          "running": {
            "type": "boolean",
            "description": "是否正在执行初始化。"
          },
          "stage": {
            "type": "string",
            "description": "当前阶段：idle、preparing、administrator、system-account、种子步骤、finalizing、completed、failed。",
            "nullable": true
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "初始化步骤顺序。前端按此列表逐项展示进度。",
            "nullable": true
          },
          "percent": {
            "type": "integer",
            "description": "当前完成百分比（0-100）。",
            "format": "int32"
          },
          "completed": {
            "type": "boolean",
            "description": "是否已完成。"
          },
          "error": {
            "type": "string",
            "description": "失败原因，仅失败时返回。",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "首次初始化进度。"
      },
      "SetupStatusDto": {
        "type": "object",
        "properties": {
          "initialized": {
            "type": "boolean",
            "description": "是否已完成系统初始化。"
          },
          "defaultAdminUserName": {
            "type": "string",
            "description": "默认管理员账号（仅未初始化时返回，用于预填）。",
            "nullable": true
          },
          "siteName": {
            "type": "string",
            "description": "默认站点名称（仅未初始化时返回）。",
            "nullable": true
          },
          "defaultLanguage": {
            "type": "string",
            "description": "默认站点语言（仅未初始化时返回）。",
            "nullable": true
          },
          "registrationEnabled": {
            "type": "boolean",
            "description": "是否默认开放注册（仅未初始化时返回）。"
          },
          "loginMaxFailedAttempts": {
            "type": "integer",
            "description": "默认登录失败锁定阈值（仅未初始化时返回）。",
            "format": "int32"
          },
          "lockoutDurationMinutes": {
            "type": "integer",
            "description": "默认锁定时长（分钟，仅未初始化时返回）。",
            "format": "int32"
          },
          "defaultTheme": {
            "type": "string",
            "description": "默认主题：auto、light 或 dark（仅未初始化时返回）。",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "系统初始化状态与首次启动默认值。"
      },
      "SiteStatusDto": {
        "type": "object",
        "properties": {
          "maintenanceMode": {
            "type": "boolean",
            "description": "Whether Web and business APIs are in maintenance mode."
          },
          "maintenanceMessage": {
            "type": "string",
            "description": "Optional operator-provided maintenance notice.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Current site runtime status exposed to Web clients."
      }
    },
    "securitySchemes": {
      "JWT Auth": {
        "type": "http",
        "description": "JWT Authorization header using the Bearer scheme. Example: \"Authorization: Bearer {token}\"",
        "scheme": "Bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    { }
  ],
  "tags": [
    {
      "name": "ClientLocalization",
      "description": "Exposes only server-owned client resources. Static component copy remains in the Web project."
    },
    {
      "name": "Setup",
      "description": "首次启动初始化：写入管理员账号、站点信息与安全策略，并标记站点已完成初始化。\r\n初始化接口只在站点尚未初始化时开放，完成后与普通业务接口一样受登录鉴权保护。"
    },
    {
      "name": "SiteStatus",
      "description": "Exposes the current deployment maintenance state. It stays reachable while other API requests are blocked."
    }
  ]
}