# Development overrides — loaded when `pnpm dev` runs.
# Uses Vite dev server proxy (/api → https://localhost:7777), so VITE_API_URL stays empty.

VITE_APP_TITLE=SimApp (Development)
VITE_API_URL=
VITE_ICP_LICENSE=
VITE_CUSTOM_ROOT_PATH=/
VITE_CUSTOM_REDIRECT=/admin/home
VITE_ADMIN_ROOT_PATH=/admin
VITE_ADMIN_DEFAULT_REDIRECT=/admin/home
VITE_ENABLE_LOAD_LOGGING=true