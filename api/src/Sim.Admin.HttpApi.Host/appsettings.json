{
  "E2eePasskeys": {
    "Enabled": false,
    "RpId": "",
    "Origins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "App": {
    "DisablePII": true,
    "HealthCheckUrl": "/health-status"
  },
  "StringEncryption": {
    "DefaultPassPhrase": ""
  },
  "Framework": {
    "Messaging": {
      "Enabled": true,
      "Provider": "RabbitMQ",
      "ClientId": "sim-admin",
      "AccessKey": "",
      "SecretKey": "",
      "SecurityProtocol": "",
      "SaslMechanism": "",
      "ConsumerMaxAttempts": 5,
      "DeadLetterTopic": "",
      "Topic": "sim.events.v1",
      "ConsumerGroup": "sim-admin",
      "Exchange": "sim.events",
      "Queue": "sim.admin.events"
    },
    "Caching": {
      "Provider": "Redis",
      "InstanceName": "sim:"
    }
  },
  "Quartz": {
    "JobStore": {
      "Provider": "postgres",
      "ConnectionStringName": "Default",
      "TablePrefix": "sim_qrtz_",
      "ClusterCheckinMisfireThreshold": 30,
      "ClusterCheckinIntervalMs": 20000
    }
  },
  "DataProtection": {
    "ApplicationName": "SimApp",
    "KeysPath": ""
  },
  "Logging": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System.Net.Http.HttpClient.ExternalLoginProvider": "Warning"
      }
    },
    "Console": {
      "Enabled": true
    },
    "File": {
      "Enabled": false,
      "Path": "Logs/log.txt"
    }
  },
  "Security": {
    "Headers": {
      "ContentSecurityPolicy": "default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://v2.jinrishici.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests;"
    },
    "SessionTimeoutMinutes": 10,
    "DeviceSessionLimits": {
      "Pc": 1,
      "Pad": 1,
      "Phone": 1
    },
    "RefreshTokenExpirationDays": 7,
    "RefreshTokenRotationMinutes": 5,
    "PasswordHashIterations": 210000,
    "RefreshTokenCookieName": "sim_refresh_token",
    "RefreshTokenCookieSecure": true,
    "EmailVerification": {
      "Enabled": false,
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "UserName": "",
      "Password": "",
      "FromAddress": ""
    },
    "SmsVerification": {
      "Enabled": false,
      "WebhookUrl": "",
      "AuthorizationHeader": ""
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "DefaultPermitLimit": 60,
    "DefaultWindowSeconds": 60,
    "QueueLimit": 0
  },
  "FileManagement": {
    "TemporaryPath": "App_Data/file-processing",
    "MaxUploadBytes": 52428800,
    "ObjectStorageWebhookSecret": "",
    "ClamAV": {
      "Enabled": false,
      "Host": "127.0.0.1",
      "Port": 3310,
      "ConnectTimeoutMs": 5000,
      "ReadTimeoutMs": 30000,
      "ChunkSize": 4096
    },
    "LibreOffice": {
      "Enabled": false,
      "ExecutablePath": "soffice",
      "TimeoutSeconds": 120
    },
    "ImageMagick": {
      "Enabled": false,
      "ExecutablePath": "magick",
      "TimeoutSeconds": 120
    }
  },
  "ScheduleTaskExecution": {
    "AllowedCommands": []
  },
  "OpenTelemetry": {
    "ServiceName": "simframework-api",
    "ServiceVersion": "1.0.0",
    "Tracing": {
      "Enabled": true
    },
    "Metrics": {
      "Enabled": true
    },
    "Otlp": {
      "Endpoint": "",
      "UseHeaders": false,
      "Headers": {}
    }
  },
  "JwtSettings": {
    "ValidAudiences": ["sim_admin_api"],
    "ValidIssuers": ["sim_admin_api"],
    "IssuerSigningKey": "",
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateIssuerSigningKey": true,
    "ValidateLifetime": true,
    "ClockSkew": 1,
    "AccessTokenExpirationMinutes": 10,
    "RefreshTokenExpirationDays": 7,
    "Issuer": "sim_admin_api",
    "Audience": "sim_admin_api",
    "SigningKeys": {
      "Keys": []
    }
  },
  "Swagger": {
    "AllowInProduction": false,
    "Documents": [
      {
        "Name": "all",
        "Title": "Sim API（全部接口）",
        "Version": "v1",
        "Url": "/swagger/all/swagger.json",
        "Description": "聚合全部模块接口，用于一次性导入 Apifox 等接口工具",
        "IncludeAll": true
      },
      {
        "Name": "admin",
        "Title": "Admin API",
        "Version": "v1",
        "Url": "/swagger/admin/swagger.json",
        "Description": "Admin API"
      },
      {
        "Name": "system",
        "Title": "System API",
        "Version": "v1",
        "Url": "/swagger/system/swagger.json",
        "Description": "系统模块 API - 文件管理、存储配置、定时任务、租户管理与后台任务监控"
      },
      {
        "Name": "approval",
        "Title": "Approval API",
        "Version": "v1",
        "Url": "/swagger/approval/swagger.json",
        "Description": "审批模块 API - 审批中心、流程定义与实例监控"
      },
      {
        "Name": "openplatform",
        "Title": "OpenPlatform API",
        "Version": "v1",
        "Url": "/swagger/openplatform/swagger.json",
        "Description": "开放平台 API - 应用管理、令牌签发与访问日志"
      }
    ]
  }
}
