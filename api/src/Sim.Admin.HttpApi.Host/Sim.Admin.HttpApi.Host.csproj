<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <PreserveCompilationReferences>true</PreserveCompilationReferences>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(OS)' == 'Windows_NT'">packages.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(OS)' != 'Windows_NT'">packages.linux.lock.json</NuGetLockFilePath>
    <UserSecretsId>de7b6fb6-edae-446c-95e9-4cf2695a0e42</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(RunConfiguration)' == 'Sim.Admin.HttpApi.Host'" />

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Core" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Logs\**" />
    <Content Remove="Logs\**" />
    <EmbeddedResource Remove="Logs\**" />
    <None Remove="Logs\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="business.db-journal" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\framework\Sim.Framework.Application\Sim.Framework.Application.csproj" />
    <ProjectReference Include="..\..\modules\system\Sim.System.Application\Sim.System.Application.csproj" />
    <ProjectReference Include="..\..\modules\system\Sim.System.SqlSugar\Sim.System.SqlSugar.csproj" />
    <ProjectReference Include="..\..\modules\openplatform\Sim.OpenPlatform.Application\Sim.OpenPlatform.Application.csproj" />
    <ProjectReference Include="..\..\modules\openplatform\Sim.OpenPlatform.SqlSugar\Sim.OpenPlatform.SqlSugar.csproj" />
    <ProjectReference Include="..\..\modules\approval\Sim.Approval.Application\Sim.Approval.Application.csproj" />
    <ProjectReference Include="..\..\modules\approval\Sim.Approval.SqlSugar\Sim.Approval.SqlSugar.csproj" />
    <ProjectReference Include="..\Sim.Admin.Application\Sim.Admin.Application.csproj" />
    <ProjectReference Include="..\Sim.Admin.SqlSugar\Sim.Admin.SqlSugar.csproj" />
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="wwwroot\images\clients\swagger.svg" />
  </ItemGroup>

  <!-- 业务模块工程引用入口。基座仓不修改本节点，业务仓统一维护 Business/BusinessProjects.props。 -->
  <Import Project="Business/BusinessProjects.props" Condition="Exists('Business/BusinessProjects.props')" />
</Project>
