{
  "App": {
    "SelfUrl": "https://localhost:7777",
    "CorsOrigins": "https://localhost:7777,http://localhost:5173",
    "AdminDefaultPassword": ""
  },
  "ExternalLogin": {
    "CallbackBaseUrl": "https://your-domain/auth/external/callback",
    "StateCookieName": "sim_external_login_state",
    "StateCookieSecure": true,
    "StateExpirationMinutes": 10,
    "Microsoft": {
      "Enabled": false,
      "Authority": "https://login.microsoftonline.com/common/v2.0",
      "ClientId": "",
      "ClientSecret": "",
      "Scopes": ["openid", "profile", "email"]
    }
  },
  "Framework": {
    "Messaging": {
      "ConnectionString": "amqp://sim:sim_dev_password@127.0.0.1:5672/%2Fsim_dev",
      "Enabled": true,
      "Provider": "RabbitMQ"
    },
    "Caching": {
      "RedisConnectionString": "127.0.0.1:6379,defaultDatabase=0",
      "Provider": "Redis"
    }
  },
  "OpenTelemetry": {
    "Environment": "development"
  },
  "DataProtection": {
    "KeysPath": "App_Data/keys"
  },
  "Logging": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System.Net.Http.HttpClient.ExternalLoginProvider": "Warning"
      }
    },
    "Console": {
      "Enabled": true
    },
    "File": {
      "Enabled": true,
      "Path": "Logs/sim-.log",
      "RetainedFileCountLimit": 30,
      "FileSizeLimitBytes": "100MB"
    }
  },
  "DataBase": {
    "EnabledSaasMultiTenancy": true,
    "EnabledCodeFirst": true,
    "EnabledDbSeed": false,
    "UseSnakeCaseNaming": true,
    "EnableSqlLog": false,
    "ConnectionConfigs": [
      {
        "ConfigId": "Default",
        "DbType": "PostgreSQL",
        "ConnectionString": "Host=127.0.0.1;Port=5432;Database=sim_dev;Username=sim;Password=sim_dev_password;Maximum Pool Size=60;Timeout=15",
        "IsAutoCloseConnection": true
      }
    ]
  },
  "Quartz": {
    "JobStore": {
      "Provider": "postgres",
      "ConnectionStringName": "Default",
      "TablePrefix": "sim_qrtz_"
    }
  }
}
